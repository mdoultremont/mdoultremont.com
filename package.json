{
  "name": "mdoultremont.com",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=20"
  },
  "repository": "https://github.com/matthieudou/mdoultremont.com.git",
  "scripts": {
    "build": "pnpm -r run build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "dev": "pnpm -r --parallel run dev",
    "dev:tools": "pnpm --filter @mdoultremont/tools dev",
    "dev:web": "pnpm --filter @mdoultremont/portfolio dev",
    "deploy:production": "pnpm -r run deploy:production",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint --deny-warnings scripts && node scripts/check-tools-boundaries.mjs && pnpm -r run lint",
    "test": "node --test scripts/tools-boundaries.test.mjs && pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "tools": "pnpm --filter @mdoultremont/tools-cli tools"
  },
  "devDependencies": {
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^6.0.2"
  }
}
