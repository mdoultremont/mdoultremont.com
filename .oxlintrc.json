{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": [
    "import",
    "jsx-a11y",
    "node",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".output/**",
    ".spacetimedb-data/**",
    ".tanstack/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/*/src/routeTree.gen.ts",
    "apps/web/content/**",
    "coverage/**"
  ],
  "rules": {
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live"]
      }
    ],
    "promise/always-return": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/preserve-manual-memoization": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "off",
    "unicorn/no-array-fill-with-reference-type": "off",
    "eslint/no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "@/server/modules/*/*",
              "!@/server/modules/database/testing",
              "!@/server/modules/object-storage/testing",
              "@/server/actions/music/*/*",
              "@/server/actions/flights/*/*",
              "@/server/actions/back-office/*/*",
              "@/server/actions/auth/*"
            ],
            "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
          }
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/tools/src/server/modules/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              },
              {
                "group": [
                  "@/server/actions/**",
                  "@/server/entrypoints/**",
                  "@/features/**"
                ],
                "message": "Backend imports only point down (entrypoints \u2192 actions \u2192 modules) and never into src/features."
              }
            ]
          }
        ],
        "import/no-cycle": "error"
      }
    },
    {
      "files": ["apps/tools/src/server/actions/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              },
              {
                "group": ["@/server/entrypoints/**", "cloudflare:workers"],
                "message": "Backend imports only point down: entrypoints \u2192 actions \u2192 modules."
              },
              {
                "group": ["@/features/**"],
                "message": "The backend must not import frontend code from src/features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/server/entrypoints/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              },
              {
                "group": ["@/features/**"],
                "message": "The backend must not import frontend code from src/features."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/features/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              },
              {
                "group": [
                  "@/server/**",
                  "!@/server/entrypoints/http/auth.server"
                ],
                "allowTypeImports": true,
                "message": "Frontend code may only import types from the backend (import type). Share runtime code through src/shared, and call the backend over HTTP."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/routes/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              },
              {
                "group": [
                  "@/server/**",
                  "!@/server/entrypoints/http/auth.server"
                ],
                "allowTypeImports": true,
                "message": "Frontend code may only import types from the backend (import type). Share runtime code through src/shared, and call the backend over HTTP."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/routes/api/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/server/modules/*/*",
                  "!@/server/modules/database/testing",
                  "!@/server/modules/object-storage/testing",
                  "@/server/actions/music/*/*",
                  "@/server/actions/flights/*/*",
                  "@/server/actions/back-office/*/*",
                  "@/server/actions/auth/*"
                ],
                "message": "Import a backend unit through its index.ts (for example @/server/modules/spotify), not its internal files."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/shared/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/server/**", "@/features/**", "@/routes/**"],
                "message": "src/shared is isomorphic: it must not import backend, features, or routes."
              }
            ]
          }
        ]
      }
    }
  ]
}
