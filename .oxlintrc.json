{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "plugins": [
    "import",
    "jsx-a11y",
    "node",
    "oxc",
    "promise",
    "react",
    "typescript",
    "unicorn",
    "vitest"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "ignorePatterns": [
    ".output/**",
    ".spacetimedb-data/**",
    ".tanstack/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/*/src/routeTree.gen.ts",
    "apps/web/content/**",
    "coverage/**"
  ],
  "rules": {
    "eslint/no-underscore-dangle": [
      "error",
      {
        "allow": ["_tag"]
      }
    ],
    "vitest/no-standalone-expect": [
      "error",
      {
        "additionalTestBlockFunctions": ["it.effect", "it.live"]
      }
    ],
    "promise/always-return": "off",
    "react/exhaustive-effect-dependencies": "off",
    "react/preserve-manual-memoization": "off",
    "react/react-in-jsx-scope": "off",
    "react/refs": "off",
    "react/set-state-in-effect": "off",
    "react-hooks/exhaustive-deps": "off",
    "unicorn/no-array-fill-with-reference-type": "off"
  },
  "overrides": [
    {
      "files": ["apps/tools-backend/src/modules/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#backend/modules/*/*",
                  "!#backend/modules/database/testing",
                  "!#backend/modules/object-storage/testing",
                  "#backend/actions/music/*/*",
                  "#backend/actions/flights/*/*",
                  "#backend/actions/back-office/*/*",
                  "#backend/actions/auth/*"
                ],
                "message": "Import backend units through their index.ts public API."
              },
              {
                "group": ["#backend/actions/**", "#backend/entrypoints/**"],
                "message": "Backend imports point down from entrypoints to actions to modules."
              }
            ]
          }
        ],
        "import/no-cycle": "error"
      }
    },
    {
      "files": ["apps/tools-backend/src/actions/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#backend/modules/*/*",
                  "!#backend/modules/database/testing",
                  "!#backend/modules/object-storage/testing",
                  "#backend/actions/music/*/*",
                  "#backend/actions/flights/*/*",
                  "#backend/actions/back-office/*/*",
                  "#backend/actions/auth/*"
                ],
                "message": "Import backend units through their index.ts public API."
              },
              {
                "group": ["#backend/entrypoints/**", "cloudflare:workers"],
                "message": "Backend imports point down from entrypoints to actions to modules."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools-backend/src/entrypoints/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "#backend/modules/*/*",
                  "!#backend/modules/database/testing",
                  "!#backend/modules/object-storage/testing",
                  "#backend/actions/music/*/*",
                  "#backend/actions/flights/*/*",
                  "#backend/actions/back-office/*/*",
                  "#backend/actions/auth/*"
                ],
                "message": "Import backend units through their index.ts public API."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["apps/tools/src/features/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@mdoultremont/tools-backend",
                  "@mdoultremont/tools-backend/**"
                ],
                "message": "Use frontend-safe contracts and the HTTP client."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/tools-contracts/**"],
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@mdoultremont/tools-backend",
                  "@mdoultremont/tools-backend/**"
                ],
                "message": "Use frontend-safe contracts and the HTTP client."
              }
            ]
          }
        ]
      }
    }
  ]
}
