{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdoultremont-tools",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mdoultremont-data",
      "database_id": "482954d4-e4c9-4f9e-89a5-ece06e26b041",
      "migrations_dir": "../tools-backend/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "mdoultremont-files" }],
  "triggers": { "crons": ["0 * * * *"] },
  "queues": {
    "producers": [
      {
        "binding": "JOBS",
        "queue": "mdoultremont-jobs",
      },
    ],
    "consumers": [
      {
        "queue": "mdoultremont-jobs",
        "max_batch_size": 1,
        "max_concurrency": 1,
        "max_batch_timeout": 1,
        "max_retries": 10,
      },
    ],
  },
  "send_email": [{ "name": "EMAIL" }],
  "ai": { "binding": "AI" },
  // Not a secret, so it ships with every deploy. Its domain must be onboarded
  // for Email Sending (see README).
  "vars": { "EMAIL_FROM": "apps@mdoultremont.com" },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": false,
    },
  },
  "routes": [{ "pattern": "tools.mdoultremont.com", "custom_domain": true }],
}
