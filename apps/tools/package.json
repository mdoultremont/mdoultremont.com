{
  "name": "@mdoultremont/tools",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mdoultremont-data --local",
    "db:migrate:remote": "wrangler d1 migrations apply mdoultremont-data --remote",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --config vitest.config.ts",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck",
    "deploy:production": "pnpm run build && pnpm run db:migrate:remote && wrangler deploy",
    "deploy:preview": "pnpm run build && wrangler versions upload"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@orpc/client": "^1.15.7",
    "@orpc/contract": "^1.15.7",
    "@orpc/server": "^1.15.7",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-devtools": "latest",
    "@tanstack/react-router": "latest",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/react-start": "latest",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "effect": "4.0.2",
    "fast-xml-parser": "5.11.2",
    "hono": "^4.13.13",
    "lucide-react": "^1.57.0",
    "maplibre-gl": "6.14.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.8.0",
    "shadcn": "^4.21.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@effect/vitest": "4.0.2",
    "@playwright/test": "^1.62.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@tanstack/devtools-vite": "latest",
    "@tanstack/router-cli": "^1.132.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "drizzle-kit": "^0.31.11",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.127.0"
  }
}
