{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mdoultremont-portfolio",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": true,
  "assets": {
    "binding": "ASSETS",
  },
  "images": {
    "binding": "IMAGES",
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
  // Workers Previews (the "Previews Base" builds) read bindings from here, not
  // from the top level.
  "previews": {
    "images": {
      "binding": "IMAGES",
    },
  },
  "routes": [{ "pattern": "mdoultremont.com", "custom_domain": true }],
}
