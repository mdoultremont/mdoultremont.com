{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "endOfLine": "lf",
  "semi": false,
  "singleQuote": false,
  "tabWidth": 2,
  "trailingComma": "es5",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    ".output/**",
    ".spacetimedb-data/**",
    ".tanstack/**",
    "**/dist/**",
    "**/node_modules/**",
    "apps/web/src/routeTree.gen.ts",
    "apps/web/content/**",
    "coverage/**",
    "pnpm-lock.yaml"
  ]
}
